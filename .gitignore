# Logs
logs
*.log

# Dependencies (covers root, ui/, .opencode/)
node_modules/

# Build output
dist
*.tsbuildinfo
.tsbuild/

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Astro's generated types for the docs site, written by astro sync on every build
.astro/

# react-email preview server build output
.react-email/

# Environment (Doppler is primary; local .env fallback stays out of git)
.env
.env.*
!.env.example

# Test coverage
coverage
*.lcov

# OpenCode runtime scaffolding (tool-managed, not ours)
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock

# Claude Code machine-local settings (launch.json and settings.json are committed)
.claude/settings.local.json

# Claude Code local git worktrees. a worktree is a whole checkout, never repository content
.claude/worktrees/

# Editor project files
.idea/
*.iml
.DS_Store

# VS Code / Cursor: commit shared enforcement, ignore personal state
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.cursor/

# the playwright mcp server's screenshot and console cache
.playwright-mcp/

# one-off migrations and probes run by hand from a developer's machine.
# a script here never joins the build graph. biome reads these files as skipped too.
*.local.ts
