# the build context is the repo root. the web and docs builds import the packages.
# everything below is either rebuilt in the image, host-only, or a secret that must never reach a layer
**/node_modules

# typescript project-reference output and the vite and astro bundles, all regenerated by the build stage
**/.tsbuild
apps/web/dist
apps/docs/dist
apps/docs/.astro

# secrets and local environment. doppler injects the real values at start
.env
.env.*
!.env.example

# version control and host tooling
.git
.gitignore
.githooks
.github

# agent and editor tooling, none of which the image runs
.agents
.claude
.opencode
.gemini
.vscode
.idea

# specs and prose that never execute in the container.
# scripts stays out of this list because the docs build needs it. the root tsconfig points at scripts,
# and the docs build reads the root tsconfig, so leaving scripts out fails the build
openspec
README.md
LICENSE
AGENTS.md
CLAUDE.md

# tests and smoke runs stay out of the runtime image
**/*.test.ts
**/*.test.tsx
**/*.smoke.ts

# the mobile app never runs in the image. the frozen install skips a workspace whose package.json is not on disk.
# the tsconfig alone stays, because the docs build reads the root tsconfig, whose references name apps/mobile
apps/mobile
!apps/mobile/tsconfig.json

# the litellm service builds from its own image, not this context
infra
docker-compose.yml
Dockerfile
.dockerignore

# macos and editor noise
.DS_Store
*.log
