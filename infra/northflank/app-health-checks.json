{
	"healthChecks": [
		{
			"type": "startupProbe",
			"protocol": "HTTP",
			"path": "/api/health",
			"port": 3000,
			"initialDelaySeconds": 5,
			"periodSeconds": 10,
			"timeoutSeconds": 5,
			"failureThreshold": 12,
			"successThreshold": 1
		},
		{
			"type": "readinessProbe",
			"protocol": "HTTP",
			"path": "/api/health/ready",
			"port": 3000,
			"initialDelaySeconds": 1,
			"periodSeconds": 10,
			"timeoutSeconds": 6,
			"failureThreshold": 3,
			"successThreshold": 1
		},
		{
			"type": "livenessProbe",
			"protocol": "HTTP",
			"path": "/api/health",
			"port": 3000,
			"initialDelaySeconds": 1,
			"periodSeconds": 10,
			"timeoutSeconds": 5,
			"failureThreshold": 6,
			"successThreshold": 1
		}
	]
}
