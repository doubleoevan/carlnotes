# CarlNotes environment variables
# Doppler (project: carlnotes) is the source of truth. A gitignored .env works as the fallback.
# Copy to .env, fill in the required section, never commit a real .env.

# ---- required: the model proxy (all you need today) ----

# fireworks: llm inference behind litellm
FIREWORKS_API_KEY=fw_xxxxxxxx

# litellm: master key for the local proxy admin and virtual key management (any long random string)
LITELLM_MASTER_KEY=sk-change-me

# litellm: optional salt for encrypting stored provider credentials. without it, the proxy encrypts with
# LITELLM_MASTER_KEY instead. set it before any credential is stored, or leave it commented out.
# adding or changing it later makes everything already encrypted unreadable
# LITELLM_SALT_KEY=

# litellm: base url of the proxy the app routes llm calls through. scans bill to the topic owner's per-user virtual key.
# the master key is only the fallback for callers with no user context (smoke scripts, tests)
LITELLM_BASE_URL=http://localhost:4000

# postgres (neon): separate database for the litellm proxy (virtual keys, spend tracking)
LITELLM_DATABASE_URL=postgresql://user:password@host/litellm?sslmode=require

# ---- app runtime: only needed once the app ships ----

# postgres (neon): the app database, pgvector enabled
DATABASE_URL=postgresql://user:password@host/carlnotes?sslmode=require

# postgres (neon): the direct, unpooled connection string. the chat room and note streams LISTEN on it,
# because neon's pooler drops notifications to a listener. unset, the app derives it from DATABASE_URL by
# dropping the "-pooler" host segment, which is right for neon and wrong for any other pooled host
DATABASE_URL_DIRECT=

# exa: semantic web search for source discovery
EXA_API_KEY=xxxxxxxx

# firecrawl: url content fetching
FIRECRAWL_API_KEY=fc-xxxxxxxx

# scan and review tuning (optional: the code has defaults when unset)
# per-Scan USD spend limit, covering everything the Scan charges: ingestion, embedding, fetch, and scoring
SCAN_BUDGET_USD=0.5
# cheap model resource score between 0 and 1
# at or above the threshold earns a premium model re-score of the resource
# with a relevance explanation
REVIEW_PROMOTION_THRESHOLD=0.6
# how long stored resource content stays reusable before a scan revalidates or refetches it (default 24h)
CONTENT_TTL_MS=86400000
# approximate limit on how many resources one scan scores. concurrent work in flight can overshoot it slightly
MAX_SCORED_RESOURCES_PER_SCAN=30
# how many resources the fetch-and-scoring stages can work on concurrently
# keep it bounded. Firecrawl enforces a per-plan concurrency limit
# set it to 1 to run serially
REVIEW_CONCURRENCY=4
# how long a conditional refetch check may run before it aborts and a real fetch runs instead (default 5s)
REVALIDATE_TIMEOUT_MS=5000
# how long one model request may run before it aborts (default 2m)
MODEL_TIMEOUT_MS=120000

# scheduled scans: set to loop the local sweep every N ms (bun run dev:worker). unset runs one sweep and exits, as a cron does
SCHEDULE_INTERVAL_MS=60000
# how long a scan may stay running before the sweep closes it out as failed (default 30m)
STALE_SCAN_MS=1800000

# temporal: the attachment-processing worker connects here (bun run dev:temporal). unset defaults to localhost:7233
TEMPORAL_ADDRESS=localhost:7233
# attachment processing: how many chunks a long document splits into, and the target characters per chunk
MAX_CHUNKS=8
CHUNK_CHARS=8000
# the most characters of merged attachment context stored and fed to a scan
MAX_ATTACHMENT_CONTEXT_CHARS=8000

# sentry: error monitoring and sampled tracing for the api and the worker. the environment tag comes from
# DOPPLER_ENVIRONMENT, which doppler already injects. leave unset to run with no error reporting at all
SENTRY_DSN=https://xxxxxxxx@oXXXXXX.ingest.sentry.io/XXXXXX
# the fraction of traces sent (default 0.1)
SENTRY_TRACES_SAMPLE_RATE=0.1

# posthog: the signup-funnel and activation events. leave unset to run with no product analytics
POSTHOG_API_KEY=phc_xxxxxxxx
# the posthog host, only needed for eu region or a self-hosted instance
POSTHOG_HOST=https://us.i.posthog.com

# llm-guard: the scanner that screens uploaded documents and fetched pages before they enter the pipeline.
# leave unset to run without it. the prompt loader's fence is unconditional, and scanning is defense in depth
LLM_GUARD_URL=http://localhost:8001
# how long one screening call may take before it fails open unscreened. page-sized text sits near 2.5s
# on a shared cpu. raise this where real scans time out instead of losing screening
LLM_GUARD_TIMEOUT_MS=2500
# the detection score at or above which a scanner's verdict counts. set from the eval harness's measured
# false-positive rate on articles that discuss prompt injection in benign prose
LLM_GUARD_INJECTION_THRESHOLD=0.8

# langfuse (cloud, us region) for llm tracing and the prompt registry
# leave unset to run with llm tracing and the prompt registry off
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# reddit: app-only oauth for the reddit source adapter (scores, comment counts, sort modes)
# leave both unset to fall back to keyless public subreddit rss
REDDIT_CLIENT_ID=xxxxxxxx
REDDIT_CLIENT_SECRET=xxxxxxxx

# youtube data api v3: youtube source adapter (unset to fall back to keyless channel/playlist atom feeds)
YOUTUBE_API_KEY=xxxxxxxx

# twitterapi.io: the x source ingester, plus the search that suggests handles for a topic.
# one operator-level key, no per-user oauth. reads bill at $0.15 per 1,000 tweets
# an x source names one handle and costs one request per scan, so at most 20 reads costing $0.003
# unset it and x sources fail in isolation, leaving the rest of a scan intact
TWITTERAPI_IO_API_KEY=xxxxxxxx

# resend: transactional and notification email, and the signup email-verification link
RESEND_API_KEY=re_xxxxxxxx
# resend: must be a domain verified in the resend account
RESEND_FROM_EMAIL="Carl Notes <noreply@example.com>"
# resend: where a reply to the app's emails goes. unset sends no reply-to, and replies go to the from address
RESEND_REPLY_EMAIL="hello@example.com"
# flagged topics and profiles are mailed here.
# unset rejects reports
SUPPORT_EMAIL="support@example.com"

# better auth: session secret (generate with: openssl rand -base64 32), also signs the signup-gate cookie
BETTER_AUTH_SECRET=xxxxxxxx
# better auth: this app's own base url, must match the OAuth apps' redirect URI.
# the vite dev origin. the browser only ever sees :5173, which proxies /api through
BETTER_AUTH_URL=http://localhost:5173

# development only: set this to your machine's own lan address, which `ipconfig getifaddr en0` prints,
# to sign in from a phone or another device on the same network. any value turns it on, and every
# private lan address is then trusted.
LAN_DEV_URL=

# google oauth: separate app per environment (its own client id, secret, and redirect URI)
GOOGLE_CLIENT_ID=xxxxxxxx
GOOGLE_CLIENT_SECRET=xxxxxxxx

# github oauth: separate app per environment (its own client id, secret, and redirect URI)
GITHUB_CLIENT_ID=xxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxx

# dev seed: fixed local login for the demo account `bun run db:seed` creates via a real signup
# change the password locally if you want. it only ever touches your dev Neon branch
DEV_USER_EMAIL=evan@carlnotes.dev
DEV_USER_PASSWORD=notesofcarl

# Object storage: Cloudflare R2 via S3 API (self-hosted: point at MinIO or S3)
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=carlnotes-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bot protection: Cloudflare Turnstile (always-pass test keys, valid on localhost)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Stripe Billing: subscriptions map to the free/plus/premium plans, and the webhook is the source of truth for the plan.
STRIPE_SECRET_KEY=sk_test_change-me
STRIPE_WEBHOOK_SECRET=whsec_change-me
STRIPE_PRICE_PLUS_MONTHLY=price_change-me
STRIPE_PRICE_PLUS_YEARLY=price_change-me
STRIPE_PRICE_PREMIUM_MONTHLY=price_change-me
STRIPE_PRICE_PREMIUM_YEARLY=price_change-me
STRIPE_PRICE_MANUAL_SCAN_OVERAGE=price_change-me
# the Stripe meter event_name behind the overage price (defaults to manual_scan_overage)
STRIPE_MANUAL_SCAN_OVERAGE_EVENT=manual_scan_overage

# Admin console: the total monthly spend to use for calculating profit
FIXED_MONTHLY_COST_CENTS=0

# the proxies whose x-forwarded-for may be believed, comma separated. each entry is an IP address or a CIDR
# range. unset, no client address can be resolved and one rate-limit bucket is shared per path. set it to the
# platform's own hops, which the app reports in its logs on the first request until this is filled in
TRUSTED_PROXIES=
