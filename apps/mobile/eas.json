{
	"cli": {
		"version": ">= 25.3.0",
		"appVersionSource": "remote"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"environment": "development",
			"bun": "1.4.4"
		},
		"development-simulator": {
			"extends": "development",
			"ios": {
				"simulator": true
			}
		},
		"preview": {
			"distribution": "internal",
			"environment": "preview",
			"channel": "preview",
			"bun": "1.4.4"
		},
		"production": {
			"environment": "production",
			"channel": "production",
			"autoIncrement": true,
			"bun": "1.4.4"
		}
	},
	"submit": {
		"production": {
			"ios": {},
			"android": {
				"serviceAccountKeyPath": "./play-service-account.json",
				"track": "internal"
			}
		}
	}
}
