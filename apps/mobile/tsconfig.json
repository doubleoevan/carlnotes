{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": ["bun", "react"],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"references": [
		{
			"path": "../../packages/client"
		},
		{
			"path": "../../packages/contracts"
		},
		{
			"path": "../../packages/core"
		},
		{
			"path": "../../packages/nightshift"
		}
	],
	"include": [
		"app/**/*.ts",
		"app/**/*.tsx",
		"src/**/*.ts",
		"src/**/*.tsx",
		".rnstorybook/**/*.ts",
		".rnstorybook/**/*.tsx",
		"*.ts"
	]
}
