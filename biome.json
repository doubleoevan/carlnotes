{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!.agents",
			"!.claude",
			"!.opencode",
			"!openspec",
			"!skills-lock.json",
			"!db/migrations",
			"!docs/design"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useBlockStatements": "error"
			},
			"complexity": {
				"noExcessiveCognitiveComplexity": "error"
			},
			"nursery": {
				"useExplicitReturnType": {
					"level": "warn",
					"options": {
						"allowExpressions": true,
						"allowedNames": ["activeSubscriptionTopicIdQuery", "loadTopicFeedData"]
					}
				}
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "asNeeded"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.tsx", "db/schema.ts"],
			"linter": { "rules": { "nursery": { "useExplicitReturnType": "off" } } }
		}
	]
}
