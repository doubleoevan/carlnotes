{
	"$schema": "./node_modules/knip/schema-jsonc.json",
	// a hint fails the run too, so an entry or an ignore that matches nothing is removed with the file it named
	"treatConfigHintsAsErrors": true,
	// vendored skills and the bundled OpenCode install, which no import reaches by design
	"ignore": [".agents/**", ".opencode/**"],
	// shadcn writes these primitives whole, and the repo keeps its generated components untouched
	"ignoreIssues": {
		"apps/web/src/components/primitives/select.tsx": ["exports"],
		"apps/web/src/components/primitives/tooltip.tsx": ["exports"]
	},
	// system binaries the package.json scripts run, installed outside node_modules
	"ignoreBinaries": ["doppler", "cloudflared"],
	"workspaces": {
		".": {
			// previewEmails.ts starts the react-email CLI with Node. the CLI loads the pinned @react-email/ui
			"ignoreDependencies": ["react-email", "@react-email/ui"],
			// knip does not read past `doppler run --`, so each file a doppler script, a shell script, or the README runs is
			// named here with its loader
			"entry": [
				// scripts/preflight.sh
				"scripts/check-package-boundaries.ts",
				"scripts/check-component-parity.ts",
				"scripts/check-client-parity.ts",
				"scripts/check-purchase-paths.ts",
				"scripts/check-contract-freeze.ts",
				// the mobile:submit and mobile:env:sync scripts
				"scripts/submit-mobile.ts",
				"scripts/sync-mobile-env.ts",
				// the README's Development section runs these backfills by hand
				"scripts/backfill-resource-content.ts",
				"scripts/backfill-vectors.ts",
				// the eval:* scripts and smoke:eval
				"evals/attachment-summaries/attachmentSummariesEval.ts",
				"evals/personal-sources-context/personalSourcesContextEval.ts",
				"evals/personal-sources-context/personalSourcesScoringEval.ts",
				"evals/updates-opener/updatesOpenerEval.ts",
				"evals/grader-calibration/graderCalibrationEval.ts",
				"evals/new-topic-chat/newTopicChatEval.ts",
				"evals/podcast-chat/podcastChatEval.ts",
				"evals/podcast-episode-script/podcastEpisodeScriptEval.ts",
				"evals/review-pipeline/reviewPipelineEval.ts",
				"evals/review-pipeline/reviewPipelineEval.smoke.ts",
				"evals/scan-report/scanReportEval.ts",
				"evals/search-queries/searchQueriesEval.ts",
				"evals/source-suggestions/sourceSuggestionsEval.ts",
				"evals/team-chat/teamChatEval.ts",
				"evals/topic-chat/topicChatEval.ts",
				"evals/topic-matching/topicMatchingEval.ts",
				"evals/topic-chat-tools/topicChatToolsEval.ts"
			]
		},
		"apps/*": {},
		// every file is exported through `./*`, so knip treats each one as an entry. this reports the exports nothing
		// imports, which is how a dead module in this workspace shows up
		"apps/api": {
			"includeEntryExports": true
		},
		"apps/worker": {
			"entry": [
				// the temporal and reset:monthly-budgets scripts
				"temporal.ts",
				"resetMonthlyBudgets.ts",
				// temporal.ts passes each workflow file to Temporal as `new URL(...)`, not as an import
				"workflows/processAttachment.ts",
				"workflows/runTopicScan.ts",
				"workflows/sendScanEmail.ts",
				"workflows/sendPushNotifications.ts",
				"workflows/recordPodcastEpisode.ts",
				"workflows/screenSource.ts",
				// the smoke:* scripts and scripts/smoke-coverage.sh
				"scan.smoke.ts",
				"links.smoke.ts",
				"podcastEpisode.smoke.ts",
				"review.smoke.ts"
			]
		},
		"apps/docs": {
			// astro.config.mjs names the route middleware by path
			"entry": ["src/routeData.ts"]
		},
		"apps/web": {
			"entry": [
				// vite.mcpViews.config.ts swaps the visit analytics module for this one by path
				"src/mcpViews/mcpViewVisitAnalytics.ts",
				// vite.mcpViews.config.ts swaps the voice detector for this one by path
				"src/mcpViews/mcpViewVoiceActivity.ts",
				// the smoke:mcp-views script, and the page mcpViewTestHost.ts bundles for the browser
				"src/mcpViews/testHost/mcpViews.smoke.ts",
				"src/mcpViews/testHost/hostPage.ts"
			],
			// the server build bundles @carlnotes/nightshift and @carlnotes/client, so the package boundary check makes the web
			// app declare what they import
			"ignoreDependencies": ["class-variance-authority", "clsx", "hono", "tailwind-merge"]
		},
		"apps/mobile": {
			// the Metro plugin loads metro.config.js, whose withStorybook rewrites .rnstorybook/storybook.requires.ts on
			// every run, so the config is read as a plain entry instead
			"metro": false,
			"entry": ["metro.config.js"],
			// the start script's EXPO_UNSTABLE_MCP_SERVER=1 makes expo start load it
			"ignoreDependencies": ["expo-mcp"]
		},
		"packages/models": {
			"includeEntryExports": true,
			// telemetry.test.ts imports it in a probe script that runs in a child process
			"ignoreDependencies": ["@sentry/bun"]
		},
		"packages/nightshift": {
			"includeEntryExports": true,
			// tokens.test.ts reads tailwindcss/theme.css through Bun.resolveSync
			"ignoreDependencies": ["tailwindcss"]
		},
		// every file is exported through `./*`, so knip treats each one as an entry. this reports the exports nothing
		// imports, which is how a dead module in a package shows up
		"packages/*": {
			"includeEntryExports": true
		}
	}
}
