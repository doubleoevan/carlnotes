{
	"name": "carlnotes",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "concurrently -k -n api,ui,temporal,worker,email -c blue,magenta,yellow,green,cyan \"bun run dev:api\" \"bun run dev:ui\" \"bun run dev:temporal:watch\" \"bun run dev:worker\" \"bun run dev:email\"",
		"dev:ui": "doppler run --command \"bun run --cwd apps/web dev\"",
		"dev:api": "doppler run -- bun --watch apps/api/index.ts",
		"dev:worker": "SCHEDULE_INTERVAL_MS=60000 doppler run -- bun apps/worker/schedule.ts",
		"dev:temporal": "bun run temporal",
		"dev:temporal:watch": "doppler run -- bun --watch apps/worker/temporal.ts",
		"dev:email": "email dev --dir packages/emails --port 3011",
		"dev:docs": "bun run --cwd apps/docs dev",
		"dev:mobile": "doppler run -- bun run --cwd apps/mobile start",
		"dev:tunnel": "cloudflared tunnel --config infra/cloudflared/dev-tunnel.yml run carlnotes-dev",
		"mobile:build": "bun run --cwd apps/mobile eas build",
		"mobile:update": "bun run --cwd apps/mobile eas update",
		"mobile:env:sync": "doppler run -- bun scripts/sync-mobile-env.ts && doppler run --config prd -- bun scripts/sync-mobile-env.ts",
		"build:ui": "bun run --cwd apps/web build",
		"build:docs": "bun run --cwd apps/docs build",
		"dev:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 bun run --cwd apps/web dev:storybook",
		"build:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 bun run --cwd apps/web build:storybook",
		"nightshift:write": "bun scripts/write-nightshift-tokens.ts",
		"check:workflows": "bun scripts/check-workflow-bundles.ts",
		"check": "bash scripts/preflight.sh",
		"test": "bun test",
		"test:coverage": "bun test --coverage",
		"smoke:coverage": "doppler run -- bash scripts/smoke-coverage.sh",
		"smoke": "bun run smoke:scan && bun run smoke:store && bun run smoke:attach && bun run smoke:search && bun run smoke:reddit && bun run smoke:x && bun run smoke:links && bun run smoke:speech && bun run smoke:podcast-episode && bun run smoke:review && bun run smoke:chat && bun run smoke:eval && bun run smoke:subscribers && bun run smoke:profile && bun run smoke:seo && bun run smoke:teams && bun run smoke:room && bun run smoke:rooms && bun run smoke:chat-turns && bun run smoke:invites && bun run smoke:mcp && bun run smoke:tools && bun run smoke:podcast-episodes && bun run smoke:search-plans",
		"smoke:scan": "doppler run -- bun apps/worker/scan.smoke.ts",
		"smoke:store": "doppler run -- bun packages/db/store.smoke.ts",
		"smoke:attach": "doppler run -- bun packages/pipeline/attach.smoke.ts",
		"smoke:search": "doppler run -- bun packages/pipeline/search.smoke.ts",
		"smoke:reddit": "doppler run -- bun packages/pipeline/reddit.smoke.ts",
		"smoke:x": "doppler run -- bun packages/pipeline/x.smoke.ts",
		"smoke:links": "doppler run -- bun apps/worker/links.smoke.ts",
		"smoke:speech": "doppler run -- bun packages/models/speech.smoke.ts",
		"smoke:podcast-episode": "doppler run -- bun apps/worker/podcastEpisode.smoke.ts",
		"smoke:review": "doppler run -- bun apps/worker/review.smoke.ts",
		"smoke:chat": "doppler run -- bun packages/pipeline/chat.smoke.ts",
		"smoke:eval": "doppler run -- bun evals/review-pipeline/reviewPipelineEval.smoke.ts",
		"smoke:subscribers": "doppler run -- bun apps/api/topic/subscriberCounts.smoke.ts",
		"smoke:profile": "doppler run -- bun apps/api/profiles.smoke.ts",
		"smoke:seo": "bun run build:ui && doppler run -- bun apps/api/seo.smoke.ts",
		"smoke:signup": "doppler run --command \"bun run build:ui && bun apps/api/signup.smoke.ts\"",
		"smoke:teams": "doppler run -- bun apps/api/team/teams.smoke.ts",
		"smoke:room": "doppler run -- bun apps/api/chat/room.smoke.ts",
		"smoke:rooms": "doppler run -- bun apps/api/chat/rooms.smoke.ts",
		"smoke:chat-turns": "doppler run -- bun packages/db/chatTurnShapes.smoke.ts",
		"smoke:invites": "doppler run -- bun apps/api/invite/invites.smoke.ts",
		"smoke:mcp": "bun run build:ui && doppler run -- bun apps/api/mcp/mcp.smoke.ts",
		"smoke:tools": "doppler run -- bun apps/api/tool/topicTools.smoke.ts",
		"smoke:podcast-episodes": "doppler run -- bun apps/api/podcast/podcastEpisodes.smoke.ts",
		"smoke:search-plans": "doppler run -- bun apps/api/searchPlans.smoke.ts",
		"eval:attachment-summaries": "doppler run -- bun evals/attachment-summaries/attachmentSummariesEval.ts",
		"eval:grader-calibration": "doppler run -- bun evals/grader-calibration/graderCalibrationEval.ts",
		"eval:new-topic-chat": "doppler run -- bun evals/new-topic-chat/newTopicChatEval.ts",
		"eval:podcast-episode-script": "doppler run -- bun evals/podcast-episode-script/podcastEpisodeScriptEval.ts",
		"eval:review-pipeline": "doppler run -- bun evals/review-pipeline/reviewPipelineEval.ts",
		"eval:scan-report": "doppler run -- bun evals/scan-report/scanReportEval.ts",
		"eval:search-queries": "doppler run -- bun evals/search-queries/searchQueriesEval.ts",
		"eval:source-suggestions": "doppler run -- bun evals/source-suggestions/sourceSuggestionsEval.ts",
		"eval:team-chat": "doppler run -- bun evals/team-chat/teamChatEval.ts",
		"eval:topic-chat": "doppler run -- bun evals/topic-chat/topicChatEval.ts",
		"eval:topic-chat-tools": "doppler run -- bun evals/topic-chat-tools/topicChatToolsEval.ts",
		"eval:podcast-chat": "doppler run -- bun evals/podcast-chat/podcastChatEval.ts",
		"sync:releases": "doppler run -- bun apps/api/releases.sync.ts",
		"sync:releases:prd": "doppler run --config prd -- bun apps/api/releases.sync.ts",
		"releases:preview": "doppler run -- bun apps/api/releases.preview.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "doppler run -- bun packages/db/migrate.ts",
		"db:seed": "doppler run -- bun apps/api/seed.ts",
		"docs:embed": "doppler run -- bun apps/worker/docsSync.ts",
		"docs:embed:prd": "doppler run --config prd -- bun apps/worker/docsSync.ts",
		"edge:purge": "doppler run -- bun apps/api/edgeCache.purge.ts",
		"prompts:sync": "doppler run -- bun packages/models/prompts/sync.ts",
		"prompts:sync:prd": "doppler run --config prd -- bun packages/models/prompts/sync.ts",
		"carl-up": "bash scripts/carl-up.sh",
		"carl-down": "bash scripts/carl-down.sh",
		"litellm:restart": "doppler run -- docker compose restart litellm",
		"llm-guard:up": "docker compose up -d llm-guard",
		"temporal": "doppler run -- bun apps/worker/temporal.ts",
		"schedule": "doppler run -- bun apps/worker/schedule.ts",
		"reset:monthly-budgets": "doppler run -- bun apps/worker/resetMonthlyBudgets.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@carlnotes/api": "workspace:*",
		"@carlnotes/client": "workspace:*",
		"@carlnotes/contracts": "workspace:*",
		"@carlnotes/db": "workspace:*",
		"@carlnotes/models": "workspace:*",
		"@carlnotes/nightshift": "workspace:*",
		"@carlnotes/pipeline": "workspace:*",
		"@carlnotes/worker": "workspace:*",
		"@react-email/ui": "6.11.3",
		"@resvg/resvg-js": "^2.6.2",
		"@temporalio/worker": "^1.24.0",
		"@types/bun": "~1.4.4",
		"ai": "^7.0.150",
		"concurrently": "^10.0.6",
		"drizzle-kit": "^0.31.11",
		"drizzle-orm": "^0.45.4",
		"promptfoo": "^0.125.0",
		"react": "19.3.1",
		"react-email": "^6.11.3",
		"typescript": "^5.9.3"
	},
	"trustedDependencies": [
		"@swc/core",
		"protobufjs"
	],
	"patchedDependencies": {
		"markdown-to-jsx@9.10.3": "patches/markdown-to-jsx@9.10.3.patch",
		"react-native-enriched-html@1.1.1": "patches/react-native-enriched-html@1.1.1.patch"
	}
}
